# ==============================================================================
# CECANI LATINOAMÉRICA - VARIABLES DE ENTORNO VERCEL / STRIPE / RESEND
# ==============================================================================
# Configura estas variables en tu panel de Vercel (Project Settings -> Environment Variables)

# 1. Stripe Secret Key (Llave secreta de Stripe)
# En desarrollo: sk_test_... | En producción: sk_live_...
STRIPE_SECRET_KEY=sk_test_tu_llave_secreta_aqui

# 2. Stripe Webhook Secret (Firma del Webhook para verificar los eventos)
# Obtenida al registrar el endpoint https://tu-dominio.vercel.app/api/webhook en Stripe Dashboard
STRIPE_WEBHOOK_SECRET=whsec_tu_firma_webhook_aqui

# 3. Resend API Key (Para el envío de correos electrónicos con el PDF adjunto)
# Obtenida gratis en https://resend.com (Plan gratuito de 3,000 correos/mes)
RESEND_API_KEY=re_tu_api_key_de_resend_aqui

# 4. Remitente oficial de correos (Opcional - por defecto usa la dirección de prueba de Resend)
RESEND_FROM_EMAIL=CECANI Latinoamérica <onboarding@resend.dev>
